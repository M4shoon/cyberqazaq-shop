# Осы файлды .env деп көшіріп, мәндерін толтырыңыз: cp .env.example .env

# Flask сессиясының құпия кілті. Жасау: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Админ панель
ADMIN_USER=admin
ADMIN_PASS=

# Gmail тапсырыс хабарламалары (App Password: Google Account → Security → 2-Step Verification → App passwords)
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=

# AI Кеңесші үшін Gemini кілті (тегін: https://aistudio.google.com → Get API key). Бірінші осы қолданылады
GEMINI_API_KEY=
# Модель атауы: GEMINI_MODEL=gemini-flash-lite-latest (әдепкі)

# Қосымша: AI Кеңесші үшін ақылы Claude API кілті (https://console.anthropic.com). Бос болса — локалды fallback жұмыс істейді
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Тек дамыту кезінде: 1 қойсаңыз debug қосылады
# FLASK_DEBUG=1
